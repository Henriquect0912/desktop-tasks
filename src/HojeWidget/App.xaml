<Application x:Class="HojeWidget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:HojeWidget.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Indice 0: tema ativo. Trocado em tempo de execucao. -->
                <ResourceDictionary Source="Themes/Black.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibility" />
            <conv:EnumToBooleanConverter x:Key="EnumToBoolean" />
            <conv:IndentToMarginConverter x:Key="IndentToMargin" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
