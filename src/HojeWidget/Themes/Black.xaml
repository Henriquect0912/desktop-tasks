<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Tema Preto: fundo visualmente solido. -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF0D0D0F" />
    <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9A9AA2" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF5E5E66" />
    <SolidColorBrush x:Key="HoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FF17171B" />
    <SolidColorBrush x:Key="FieldBorderBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="CheckboxBorderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="CheckboxFillBrush" Color="#FFF4F4F6" />
    <SolidColorBrush x:Key="CheckboxGlyphBrush" Color="#FF0D0D0F" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="DropIndicatorBrush" Color="#FF7FB2FF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#E60D0D0F" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC46B" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="ProgressFillBrush" Color="#FF7FB2FF" />

</ResourceDictionary>
